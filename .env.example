# Salin file ini jadi .env lalu isi dari Firebase Console
# (Project settings -> General -> Your apps -> Web app -> SDK setup and configuration)
#
# Kalau variabel di bawah dikosongkan, aplikasi tetap jalan dalam MODE LOKAL
# (data disimpan di browser masing-masing, TIDAK sinkron antar perangkat).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Nama "ruangan" data di database. Boleh diganti kalau mau bikin acara lain.
VITE_ROOM_ID=17an
