# Aplikasi sudah memakai project Firebase bawaan (lihat DEFAULT_FIREBASE di src/lib/db.ts),
# jadi file ini TIDAK WAJIB diisi. Salin jadi .env cuma kalau mau:
#
#  - memakai project Firebase lain, atau
#  - memisahkan data acara ke ruangan lain lewat VITE_ROOM_ID.
#
# Nilai konfigurasi diambil dari Firebase Console:
# Project settings -> General -> Your apps -> Web app -> SDK setup and configuration.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Nama "ruangan" data di database. Ganti untuk acara berikutnya, mis. agustusan-2027,
# supaya data acara lama tetap utuh.
VITE_ROOM_ID=17an

# Isi 1 kalau mau latihan tanpa menyentuh database sama sekali
# (data hanya disimpan di browser, tidak sinkron antar perangkat).
VITE_LOCAL_MODE=
